# Optional multimodal LLM configuration.
# The application works without these values and falls back to rule-based summaries.
DRAWING_COMPARE_LLM_URL=https://provider.example/v1/chat/completions
DRAWING_COMPARE_LLM_API_KEY=replace-with-your-api-key
DRAWING_COMPARE_LLM_MODEL=vision-model-name

# Optional DWG converter paths on Windows.
# ACCORECONSOLE=C:\Program Files\Autodesk\AutoCAD 2027\accoreconsole.exe
# ODA_FILE_CONVERTER=C:\Program Files\ODA\ODAFileConverter\ODAFileConverter.exe
